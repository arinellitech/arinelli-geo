# ---- Banco (worker e dashboard) ------------------------------------------
# Supabase > Project Settings > Database > Connection string (Transaction pooler, porta 6543).
# O worker usa prepare:false, obrigatório no pooler de transação.
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ---- Modelos ---------------------------------------------------------------
# Opção A (recomendada): uma chave só via Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Opção B: chaves diretas (usadas quando AI_GATEWAY_API_KEY está vazia).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
PERPLEXITY_API_KEY=

# ---- Dashboard (/dashboard no site) ---------------------------------------
DASHBOARD_USER=patrick
DASHBOARD_PASSWORD=
