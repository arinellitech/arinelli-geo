# Transaction pooler (porta 6543) com o role geo_worker (migration 20261018214324), nunca o postgres:
# o banco é compartilhado. O worker usa prepare:false, obrigatório nesse pooler.
# Na Vercel (só o dashboard) use o geo_reader (migration 20261019163847), só de leitura.
DATABASE_URL=postgresql://geo_worker.srqidfdksprzklolqoaf:SENHA@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ---- Modelos ---------------------------------------------------------------
